# ========================================================
# M. Nawaz Jewelry Collection - Environment Variables
# ========================================================

# 1. Cloudinary (REQUIRED for Admin Image Uploads)
# Create a free account at https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=mnawaz_preset

# 2. Firebase Cloud (OPTIONAL - LocalStorage fallback is active)
# Create a project at https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mnawaz-jewelry
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 3. Live Site URL (For Canonical SEO & Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
